# This is an example environment file to configure Navidrome. Rename this file
# with the `.example` extension removed and it will be automatically "installed"
# into your configuration directory when using the install recipe.

SELFHOST_NAVIDROME_PORT=4533
SELFHOST_MUSIC_DIR=/home/username/music
SELFHOST_NAVIDROME_DATA_DIR=/home/username/.navidrome/data
